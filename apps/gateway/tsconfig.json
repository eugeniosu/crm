{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@crm/typescript-config/base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["bun"]
	},
	"include": [
		"src/**/*.ts",
		"scripts/**/*.ts",
		"test/**/*.ts",
		"prisma.config.ts"
	],
	"exclude": ["node_modules", "src/generated"]
}
